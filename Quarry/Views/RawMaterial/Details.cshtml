@model QuarryManagementSystem.Models.Domain.RawMaterial
@{
    ViewData["Title"] = "Raw Material Details";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">@Model.Name</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard")">Home</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Raw Materials</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Details</h3></div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8">@Model.Name</dd>
                            <dt class="col-sm-4">Unit</dt>
                            <dd class="col-sm-8">@Model.Unit</dd>
                            <dt class="col-sm-4">Status</dt>
                            <dd class="col-sm-8">@Model.Status</dd>
                            <dt class="col-sm-4">Created</dt>
                            <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                        </dl>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Edit</a>
                        <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fas fa-list"></i> Back to List</a>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Recent Receipts</h3></div>
                    <div class="card-body p-0">
                        @if (Model.Receipts == null || !Model.Receipts.Any())
                        {
                            <div class="p-3 text-muted">No receipts recorded yet.</div>
                        }
                        else
                        {
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Receipt #</th>
                                        <th>Date</th>
                                        <th>Quarry</th>
                                        <th class="text-right">Quantity</th>
                                        <th class="text-right">Unit Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rc in Model.Receipts.OrderByDescending(r => r.ReceiptDate).Take(10))
                                    {
                                        <tr>
                                            <td>@rc.ReceiptNumber</td>
                                            <td>@rc.ReceiptDate.ToString("yyyy-MM-dd")</td>
                                            <td>@(rc.Quarry?.Name ?? "-")</td>
                                            <td class="text-right">@rc.Quantity.ToString("N3")</td>
                                            <td class="text-right">@rc.UnitCost.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
