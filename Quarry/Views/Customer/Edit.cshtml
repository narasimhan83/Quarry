@model QuarryManagementSystem.ViewModels.CustomerEditViewModel
@{
    ViewData["Title"] = "Edit Customer";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Edit Customer</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Home</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Customer")">Customers</a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="customerForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Customer Information</h3>
                            <div class="card-tools">
                                <span class="badge badge-info">Outstanding: ₦@Model.OutstandingBalance.ToString("N2")</span>
                                <span class="badge badge-success">Available Credit: ₦@Model.AvailableCredit.ToString("N2")</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div asp-validation-summary="All" class="alert alert-danger" role="alert" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Name" class="control-label"></label>
                                        <input asp-for="Name" class="form-control" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="RCNumber" class="control-label"></label>
                                        <input asp-for="RCNumber" class="form-control bg-light" readonly />
                                        <small class="form-text text-muted">System-assigned. Not editable.</small>
                                        <span asp-validation-for="RCNumber" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label asp-for="CustomerTypeId" class="control-label"></label>
                                        <select asp-for="CustomerTypeId" asp-items="Model.CustomerTypes" class="form-control">
                                            <option value="">-- Select Customer Type --</option>
                                        </select>
                                        <span asp-validation-for="CustomerTypeId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label asp-for="VatTypeId" class="control-label"></label>
                                        <select asp-for="VatTypeId" asp-items="Model.VatTypes" class="form-control">
                                            <option value="">-- Select VAT Type --</option>
                                        </select>
                                        <span asp-validation-for="VatTypeId" class="text-danger"></span>
                                        <small class="form-text text-muted">Inclusive = prices include VAT; Exclusive = VAT added on top.</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Status" class="control-label"></label>
                                        <select asp-for="Status" asp-items="Model.Statuses" class="form-control"></select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="ContactPerson" class="control-label"></label>
                                        <input asp-for="ContactPerson" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Phone" class="control-label"></label>
                                        <input asp-for="Phone" class="form-control" placeholder="Phone (Optional)" />
                                        <span asp-validation-for="Phone" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Email" class="control-label"></label>
                                        <input asp-for="Email" class="form-control" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="CreditLimit" class="control-label"></label>
                                        <div class="input-group">
                                            <div class="input-group-prepend"><span class="input-group-text">₦</span></div>
                                            <input asp-for="CreditLimit" class="form-control money-input" />
                                        </div>
                                        <span asp-validation-for="CreditLimit" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="State" class="control-label"></label>
                                        <select asp-for="State" asp-items="Model.States" class="form-control"></select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="LGA" class="control-label"></label>
                                        <select asp-for="LGA" asp-items="Model.LGAs" class="form-control"></select>
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" asp-for="MiningLicenseNumber" />

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="TIN" class="control-label"></label>
                                        <input asp-for="TIN" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="BillingAddress" class="control-label"></label>
                                <span id="billingAddressRequired" class="text-danger" style="display:none;">*</span>
                                <textarea asp-for="BillingAddress" class="form-control" rows="2"></textarea>
                                <span id="billingAddressError" class="text-danger" style="display:none;">Billing Address is required for Company customers.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Rebate & Transport -->
                    <div class="card card-warning">
                        <div class="card-header"><h3 class="card-title">Rebate &amp; Transport</h3></div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="control-label d-block">Has Rebate?</label>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input rebate-radio" type="radio" name="HasRebate" id="HasRebateYes" value="true" @(Model.HasRebate ? "checked" : "") />
                                        <label class="form-check-label" for="HasRebateYes">Yes</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input rebate-radio" type="radio" name="HasRebate" id="HasRebateNo" value="false" @(!Model.HasRebate ? "checked" : "") />
                                        <label class="form-check-label" for="HasRebateNo">No</label>
                                    </div>
                                    <div id="rebateAmountBox" class="mt-2" style="@(Model.HasRebate ? "" : "display:none;")">
                                        <label asp-for="RebateAmount" class="control-label"></label>
                                        <div class="input-group">
                                            <div class="input-group-prepend"><span class="input-group-text">₦</span></div>
                                            <input asp-for="RebateAmount" class="form-control money-input" />
                                        </div>
                                        <small class="form-text text-muted">Applied automatically as a discount line on every invoice.</small>
                                        <span asp-validation-for="RebateAmount" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="control-label d-block">Transport Required?</label>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input transport-radio" type="radio" name="TransportRequired" id="TransportYes" value="true" @(Model.TransportRequired ? "checked" : "") />
                                        <label class="form-check-label" for="TransportYes">Yes</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input transport-radio" type="radio" name="TransportRequired" id="TransportNo" value="false" @(!Model.TransportRequired ? "checked" : "") />
                                        <label class="form-check-label" for="TransportNo">No</label>
                                    </div>
                                    <div id="transportAmountBox" class="mt-2" style="@(Model.TransportRequired ? "" : "display:none;")">
                                        <label asp-for="TransportAmount" class="control-label"></label>
                                        <div class="input-group">
                                            <div class="input-group-prepend"><span class="input-group-text">₦</span></div>
                                            <input asp-for="TransportAmount" class="form-control money-input" />
                                        </div>
                                        <small class="form-text text-muted">Added automatically as an extra line on every invoice.</small>
                                        <span asp-validation-for="TransportAmount" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Material pricing -->
                    <div class="card card-info">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <h3 class="card-title mb-0">Material Pricing</h3>
                            <button type="button" id="addPriceBtn" class="btn btn-sm btn-light">
                                <i class="fas fa-plus"></i> Add Material
                            </button>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Changing a price here creates a new history row (old prices preserved). Existing invoices are unaffected.</p>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered" id="pricesTable">
                                    <thead>
                                        <tr>
                                            <th style="width: 36%;">Material</th>
                                            <th style="width: 20%;">Unit Price (₦)</th>
                                            <th style="width: 14%;">VAT Rate (%)</th>
                                            <th style="width: 18%;">Effective From</th>
                                            <th style="width: 12%;"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="pricesBody">
                                        @{ var idx = 0; }
                                        @foreach (var p in Model.MaterialPrices)
                                        {
                                            <tr>
                                                <td>
                                                    <select name="MaterialPrices[@idx].MaterialId" class="form-control form-control-sm material-select">
                                                        <option value="">-- Select --</option>
                                                        @foreach (var m in Model.Materials)
                                                        {
                                                            if (p.MaterialId?.ToString() == m.Value)
                                                            {
                                                                <option value="@m.Value" selected="selected">@m.Text</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@m.Value">@m.Text</option>
                                                            }
                                                        }
                                                    </select>
                                                    <input type="hidden" name="MaterialPrices[@idx].Id" value="@p.Id" />
                                                </td>
                                                <td>
                                                    <input type="number" step="0.01" min="0" name="MaterialPrices[@idx].UnitPrice" value="@p.UnitPrice" class="form-control form-control-sm price-input money-input" data-symbol="false" />
                                                </td>
                                                <td>
                                                    <input type="number" step="0.01" min="0" max="100" name="MaterialPrices[@idx].VatRate" value="@(p.VatRate?.ToString() ?? "")" class="form-control form-control-sm vat-input" placeholder="Default" />
                                                </td>
                                                <td>
                                                    <input type="date" name="MaterialPrices[@idx].EffectiveFrom" value="@p.EffectiveFrom.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                                                </td>
                                                <td class="text-center align-middle">
                                                    <button type="button" class="btn btn-sm btn-danger remove-price"><i class="fas fa-trash"></i></button>
                                                </td>
                                            </tr>
                                            idx++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Trucks -->
                    <div class="card card-success">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <h3 class="card-title mb-0">Customer Trucks</h3>
                            <button type="button" id="addTruckBtn" class="btn btn-sm btn-light">
                                <i class="fas fa-plus"></i> Add Truck
                            </button>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Register the truck/plate numbers belonging to this customer. Truck numbers must be unique per customer.</p>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered" id="trucksTable">
                                    <thead>
                                        <tr>
                                            <th style="width: 70%;">Truck Number</th>
                                            <th style="width: 18%;" class="text-center">Active</th>
                                            <th style="width: 12%;"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="trucksBody">
                                        @{ var tIdx = 0; }
                                        @foreach (var t in Model.Trucks)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="Trucks[@tIdx].Id" value="@t.Id" />
                                                    <input type="text" name="Trucks[@tIdx].CustomerTruckNumber" value="@t.CustomerTruckNumber" class="form-control form-control-sm truck-input" maxlength="100" placeholder="e.g. ABC123XY" />
                                                </td>
                                                <td class="text-center align-middle">
                                                    <input type="hidden" name="Trucks[@tIdx].IsActive" value="false" />
                                                    <input type="checkbox" name="Trucks[@tIdx].IsActive" value="true" @(t.IsActive ? "checked" : "") />
                                                </td>
                                                <td class="text-center align-middle">
                                                    <button type="button" class="btn btn-sm btn-danger remove-truck"><i class="fas fa-trash"></i></button>
                                                </td>
                                            </tr>
                                            tIdx++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Bank Accounts -->
                    <div class="card card-secondary">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <h3 class="card-title mb-0">Customer Bank Accounts</h3>
                            <button type="button" id="addBankBtn" class="btn btn-sm btn-light">
                                <i class="fas fa-plus"></i> Add Bank
                            </button>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Account Number and Bank Name are required. Address, Branch and SWIFT code are optional. Account numbers must be unique per customer.</p>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered" id="banksTable">
                                    <thead>
                                        <tr>
                                            <th style="width: 16%;">Account Number <span class="text-danger">*</span></th>
                                            <th style="width: 18%;">Bank Name <span class="text-danger">*</span></th>
                                            <th style="width: 22%;">Bank Address</th>
                                            <th style="width: 16%;">Branch</th>
                                            <th style="width: 12%;">SWIFT Code</th>
                                            <th style="width: 8%;" class="text-center">Active</th>
                                            <th style="width: 8%;"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="banksBody">
                                        @{ var bIdx = 0; }
                                        @foreach (var b in Model.BankAccounts)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="BankAccounts[@bIdx].Id" value="@b.Id" />
                                                    <input type="text" name="BankAccounts[@bIdx].AccountNumber" value="@b.AccountNumber" class="form-control form-control-sm bank-account-input" maxlength="50" />
                                                </td>
                                                <td>
                                                    <input type="text" name="BankAccounts[@bIdx].BankName" value="@b.BankName" class="form-control form-control-sm bank-name-input" maxlength="150" />
                                                </td>
                                                <td>
                                                    <input type="text" name="BankAccounts[@bIdx].BankAddress" value="@b.BankAddress" class="form-control form-control-sm" maxlength="255" />
                                                </td>
                                                <td>
                                                    <input type="text" name="BankAccounts[@bIdx].BankBranch" value="@b.BankBranch" class="form-control form-control-sm" maxlength="150" />
                                                </td>
                                                <td>
                                                    <input type="text" name="BankAccounts[@bIdx].BankSwiftCode" value="@b.BankSwiftCode" class="form-control form-control-sm bank-swift-input" maxlength="20" />
                                                </td>
                                                <td class="text-center align-middle">
                                                    <input type="hidden" name="BankAccounts[@bIdx].IsActive" value="false" />
                                                    <input type="checkbox" name="BankAccounts[@bIdx].IsActive" value="true" @(b.IsActive ? "checked" : "") />
                                                </td>
                                                <td class="text-center align-middle">
                                                    <button type="button" class="btn btn-sm btn-danger remove-bank"><i class="fas fa-trash"></i></button>
                                                </td>
                                            </tr>
                                            bIdx++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        $(function () {
            function wireToggle(radioClass, boxId, amountInputName) {
                $(document).on('change', '.' + radioClass, function () {
                    var isYes = $('.' + radioClass + ':checked').val() === 'true';
                    $('#' + boxId).toggle(isYes);
                    if (!isYes) {
                        $('input[name="' + amountInputName + '"]').val('');
                    }
                });
            }
            wireToggle('rebate-radio', 'rebateAmountBox', 'RebateAmount');
            wireToggle('transport-radio', 'transportAmountBox', 'TransportAmount');

            var materialsHtml = '@Html.Raw(string.Join("", Model.Materials.Select(m => $"<option value=\\\"{m.Value}\\\">{System.Net.WebUtility.HtmlEncode(m.Text)}</option>")))';
            var today = new Date().toISOString().split('T')[0];

            function renumberPriceRows() {
                $('#pricesBody tr').each(function (i) {
                    $(this).find('input, select').each(function () {
                        var name = $(this).attr('name');
                        if (!name) return;
                        $(this).attr('name', name.replace(/MaterialPrices\[\d+\]/, 'MaterialPrices[' + i + ']'));
                    });
                });
            }

            function wirePriceRowEvents($tr) {
                $tr.find('.remove-price').on('click', function () {
                    $tr.remove();
                    renumberPriceRows();
                });

                $tr.find('.material-select').on('change', function () {
                    var materialId = $(this).val();
                    if (!materialId) return;
                    $.getJSON('@Url.Action("GetMaterialCatalog", "Customer")', { materialId: materialId }, function (data) {
                        if (!data || !data.success) return;

                        var $priceInputs = $tr.find('.price-input');
                        var $realPrice = $priceInputs.filter('[type=hidden]').first();
                        if (!$realPrice.length) $realPrice = $priceInputs.first();

                        if (!parseFloat($realPrice.val())) {
                            $realPrice.val(data.unitPrice).trigger('change');
                        }

                        var $vat = $tr.find('.vat-input');
                        if (!$vat.val()) $vat.val(data.vatRate);
                    });
                });
            }

            function addPriceRow() {
                var idx = $('#pricesBody tr').length;
                var row = `
<tr>
  <td>
    <select name="MaterialPrices[${idx}].MaterialId" class="form-control form-control-sm material-select">
      <option value="">-- Select --</option>${materialsHtml}
    </select>
    <input type="hidden" name="MaterialPrices[${idx}].Id" value="0" />
  </td>
  <td><input type="number" step="0.01" min="0" name="MaterialPrices[${idx}].UnitPrice" value="0" class="form-control form-control-sm price-input money-input" data-symbol="false" /></td>
  <td><input type="number" step="0.01" min="0" max="100" name="MaterialPrices[${idx}].VatRate" value="" class="form-control form-control-sm vat-input" placeholder="Default" /></td>
  <td><input type="date" name="MaterialPrices[${idx}].EffectiveFrom" value="${today}" class="form-control form-control-sm" /></td>
  <td class="text-center align-middle">
    <button type="button" class="btn btn-sm btn-danger remove-price"><i class="fas fa-trash"></i></button>
  </td>
</tr>`;
                var $row = $(row);
                $('#pricesBody').append($row);
                if (window.NairaFormat && NairaFormat.scan) NairaFormat.scan($row);
                wirePriceRowEvents($row);
            }

            $('#pricesBody tr').each(function () { wirePriceRowEvents($(this)); });
            $('#addPriceBtn').on('click', function () { addPriceRow(); });

            // ----- Customer Trucks dynamic rows -----
            function renumberTruckRows() {
                $('#trucksBody tr').each(function (i) {
                    $(this).find('input').each(function () {
                        var name = $(this).attr('name');
                        if (!name) return;
                        $(this).attr('name', name.replace(/Trucks\[\d+\]/, 'Trucks[' + i + ']'));
                    });
                });
            }

            function wireTruckRowEvents($tr) {
                $tr.find('.remove-truck').on('click', function () {
                    $tr.remove();
                    renumberTruckRows();
                });
                $tr.find('.truck-input').on('input', function () {
                    $(this).val($(this).val().toUpperCase());
                });
            }

            function addTruckRow() {
                var idx = $('#trucksBody tr').length;
                var row = `
<tr>
  <td>
    <input type="hidden" name="Trucks[${idx}].Id" value="0" />
    <input type="text" name="Trucks[${idx}].CustomerTruckNumber" value="" class="form-control form-control-sm truck-input" maxlength="100" placeholder="e.g. ABC123XY" />
  </td>
  <td class="text-center align-middle">
    <input type="hidden" name="Trucks[${idx}].IsActive" value="false" />
    <input type="checkbox" name="Trucks[${idx}].IsActive" value="true" checked />
  </td>
  <td class="text-center align-middle">
    <button type="button" class="btn btn-sm btn-danger remove-truck"><i class="fas fa-trash"></i></button>
  </td>
</tr>`;
                var $row = $(row);
                $('#trucksBody').append($row);
                wireTruckRowEvents($row);
                $row.find('.truck-input').focus();
            }

            $('#trucksBody tr').each(function () { wireTruckRowEvents($(this)); });
            $('#addTruckBtn').on('click', function () { addTruckRow(); });

            // ----- Customer Bank Accounts dynamic rows -----
            function renumberBankRows() {
                $('#banksBody tr').each(function (i) {
                    $(this).find('input').each(function () {
                        var name = $(this).attr('name');
                        if (!name) return;
                        $(this).attr('name', name.replace(/BankAccounts\[\d+\]/, 'BankAccounts[' + i + ']'));
                    });
                });
            }

            function wireBankRowEvents($tr) {
                $tr.find('.remove-bank').on('click', function () {
                    $tr.remove();
                    renumberBankRows();
                });
                // Account number: digits only, sensible upper bound.
                $tr.find('.bank-account-input').on('input', function () {
                    var v = $(this).val().replace(/\D/g, '');
                    if (v.length > 20) v = v.substring(0, 20);
                    $(this).val(v);
                });
                // SWIFT: uppercase letters and digits (8 or 11 chars typical).
                $tr.find('.bank-swift-input').on('input', function () {
                    $(this).val($(this).val().toUpperCase().replace(/[^A-Z0-9]/g, ''));
                });
            }

            function addBankRow() {
                var idx = $('#banksBody tr').length;
                var row = `
<tr>
  <td>
    <input type="hidden" name="BankAccounts[${idx}].Id" value="0" />
    <input type="text" name="BankAccounts[${idx}].AccountNumber" value="" class="form-control form-control-sm bank-account-input" maxlength="50" />
  </td>
  <td><input type="text" name="BankAccounts[${idx}].BankName" value="" class="form-control form-control-sm bank-name-input" maxlength="150" /></td>
  <td><input type="text" name="BankAccounts[${idx}].BankAddress" value="" class="form-control form-control-sm" maxlength="255" /></td>
  <td><input type="text" name="BankAccounts[${idx}].BankBranch" value="" class="form-control form-control-sm" maxlength="150" /></td>
  <td><input type="text" name="BankAccounts[${idx}].BankSwiftCode" value="" class="form-control form-control-sm bank-swift-input" maxlength="20" /></td>
  <td class="text-center align-middle">
    <input type="hidden" name="BankAccounts[${idx}].IsActive" value="false" />
    <input type="checkbox" name="BankAccounts[${idx}].IsActive" value="true" checked />
  </td>
  <td class="text-center align-middle">
    <button type="button" class="btn btn-sm btn-danger remove-bank"><i class="fas fa-trash"></i></button>
  </td>
</tr>`;
                var $row = $(row);
                $('#banksBody').append($row);
                wireBankRowEvents($row);
                $row.find('.bank-account-input').focus();
            }

            $('#banksBody tr').each(function () { wireBankRowEvents($(this)); });
            $('#addBankBtn').on('click', function () { addBankRow(); });

            // Phone / BVN / TIN helpers
            $('#Phone').on('input', function () {
                var phone = $(this).val().replace(/\D/g, '');
                if (phone.length >= 11) {
                    if (phone.startsWith('234')) {
                        phone = '+' + phone.substring(0, 3) + phone.substring(3, 6) + phone.substring(6, 10) + phone.substring(10);
                    } else if (phone.startsWith('0')) {
                        phone = phone.substring(0, 4) + phone.substring(4, 7) + phone.substring(7, 11);
                    }
                }
                $(this).val(phone);
            });
            $('#TIN').on('input', function () {
                var tin = $(this).val().replace(/\D/g, '');
                if (tin.length > 12) tin = tin.substring(0, 12);
                $(this).val(tin);
            });

            // For Company customers: enable TIN and make Billing Address mandatory.
            // For Individual (or anything else): disable TIN and Billing Address is optional.
            // Also: Rebate is for Individuals only — forced off and hidden for Company,
            // pre-filled to Yes / ₦700 the FIRST time an Individual is selected in
            // this session, but never overrides values the operator has already typed.
            var rebateDefaultsApplied = false;
            function applyCustomerTypeRules() {
                var typeText = ($('#CustomerTypeId option:selected').text() || '').trim().toLowerCase();
                var isCompany = typeText === 'company';
                var isIndividual = typeText === 'individual';

                // TIN field
                var $tin = $('#TIN');
                if (isCompany) {
                    $tin.prop('disabled', false).removeClass('bg-light');
                } else {
                    $tin.val('').prop('disabled', true).addClass('bg-light');
                }

                // Billing Address requirement
                var $billing = $('#BillingAddress');
                if (isCompany) {
                    $billing.attr('required', 'required');
                    $('#billingAddressRequired').show();
                } else {
                    $billing.removeAttr('required');
                    $('#billingAddressRequired').hide();
                    $('#billingAddressError').hide();
                    $billing.removeClass('is-invalid');
                }

                // Rebate handling
                var $rebateYes = $('#HasRebateYes');
                var $rebateNo  = $('#HasRebateNo');
                var $rebateAmt = $('input[name="RebateAmount"]');
                var $rebateBox = $('#rebateAmountBox');

                if (isCompany) {
                    // Company: rebate is not applicable. Force No, disable both
                    // radios and the amount, and clear the value.
                    $rebateNo.prop('checked', true);
                    $rebateYes.prop('checked', false);
                    $rebateYes.prop('disabled', true);
                    $rebateNo.prop('disabled', true);
                    $rebateAmt.val('').prop('disabled', true).addClass('bg-light');
                    $rebateBox.hide();
                } else if (isIndividual) {
                    // Individual: rebate is enabled. The first time the operator
                    // picks Individual in this session, default to Yes / 700 —
                    // but only if no value has been saved yet (avoids overwriting
                    // existing data on the Edit screen).
                    $rebateYes.prop('disabled', false);
                    $rebateNo.prop('disabled', false);
                    $rebateAmt.prop('disabled', false).removeClass('bg-light');

                    if (!rebateDefaultsApplied) {
                        var nothingChecked = !$rebateYes.is(':checked') && !$rebateNo.is(':checked');
                        if (nothingChecked) {
                            $rebateYes.prop('checked', true);
                        }
                        if ($rebateYes.is(':checked') && !parseFloat($rebateAmt.val())) {
                            // Use the formatted-money helper if present so the
                            // ₦ prefix and commas render; fall back to a plain set.
                            if (window.NairaFormat && typeof NairaFormat.setValue === 'function') {
                                NairaFormat.setValue($rebateAmt[0], 700);
                            } else {
                                $rebateAmt.val(700).trigger('change');
                            }
                        }
                        rebateDefaultsApplied = true;
                    }
                    $rebateBox.toggle($rebateYes.is(':checked'));
                } else {
                    // No type chosen yet: leave radios alone but ensure they are
                    // not stuck disabled from a prior Company selection.
                    $rebateYes.prop('disabled', false);
                    $rebateNo.prop('disabled', false);
                    $rebateAmt.prop('disabled', false).removeClass('bg-light');
                }
            }
            $('#CustomerTypeId').on('change', applyCustomerTypeRules);
            applyCustomerTypeRules();

            // Client-side guard: block submit when Company is selected but Billing Address is empty
            $('#customerForm').on('submit', function (e) {
                var typeText = ($('#CustomerTypeId option:selected').text() || '').trim().toLowerCase();
                if (typeText === 'company') {
                    var $billing = $('#BillingAddress');
                    if (!$.trim($billing.val())) {
                        e.preventDefault();
                        $billing.addClass('is-invalid').focus();
                        $('#billingAddressError').show();
                        return false;
                    }
                }
            });
            $('#BillingAddress').on('input', function () {
                if ($.trim($(this).val())) {
                    $(this).removeClass('is-invalid');
                    $('#billingAddressError').hide();
                }
            });
        });
    </script>
}
