@model IEnumerable<QuarryManagementSystem.Models.Domain.RawMaterialReceipt>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Raw Material Receipts";
    var quarries = ViewBag.Quarries as List<SelectListItem> ?? new List<SelectListItem>();
    var rawMaterials = ViewBag.RawMaterials as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Raw Material Receipts</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard")">Home</a></li>
                    <li class="breadcrumb-item active">Receipts</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="card card-outline card-primary">
            <div class="card-header">
                <h3 class="card-title">Filters</h3>
            </div>
            <div class="card-body">
                <form method="get" class="form-inline">
                    <div class="form-group mr-2">
                        <label class="mr-2">Quarry</label>
                        <select name="quarryId" class="form-control">
                            <option value="">All</option>
                            @foreach (var q in quarries)
                            {
                                <option value="@q.Value">@q.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mr-2">
                        <label class="mr-2">Raw Material</label>
                        <select name="rawMaterialId" class="form-control">
                            <option value="">All</option>
                            @foreach (var r in rawMaterials)
                            {
                                <option value="@r.Value">@r.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mr-2">
                        <label class="mr-2">From</label>
                        <input type="date" name="fromDate" class="form-control" />
                    </div>
                    <div class="form-group mr-2">
                        <label class="mr-2">To</label>
                        <input type="date" name="toDate" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Filter</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title mb-0">Receipts</h3>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> New Receipt
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="p-4 text-muted">No receipts match the filters. Use "New Receipt" to record raw material delivered to a yard.</div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Receipt #</th>
                                <th>Date</th>
                                <th>Quarry</th>
                                <th>Raw Material</th>
                                <th class="text-right">Quantity</th>
                                <th class="text-right">Unit Cost</th>
                                <th class="text-right">Total Cost</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td><strong>@r.ReceiptNumber</strong></td>
                                    <td>@r.ReceiptDate.ToString("yyyy-MM-dd")</td>
                                    <td>@(r.Quarry?.Name ?? "-")</td>
                                    <td>@(r.RawMaterial?.Name ?? "-")</td>
                                    <td class="text-right">@r.Quantity.ToString("N3")</td>
                                    <td class="text-right">@r.UnitCost.ToString("N2")</td>
                                    <td class="text-right">@r.TotalCost.ToString("N2")</td>
                                    <td class="text-right">
                                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-info"><i class="fas fa-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</section>
