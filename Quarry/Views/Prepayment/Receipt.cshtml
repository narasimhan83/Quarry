@model QuarryManagementSystem.ViewModels.PrepaymentReceiptPrintViewModel
@{
    Layout = null; // Print-friendly standalone
    var p = Model.Prepayment;
    var company = Model.CompanyDetails;
    var customer = p.Customer;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Prepayment Receipt @p.PrepaymentNumber - Print</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        :root {
            --primary: #1f2937;
            --muted: #6b7280;
            --border: #e5e7eb;
            --accent: #111827;
        }
        * { box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif;
            color: #111827;
            margin: 0;
            background: #fff;
        }
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            background: #fff;
        }
        .toolbar h1 { font-size: 18px; margin: 0; }
        .btn {
            background: var(--primary);
            color: #fff;
            border: 0;
            padding: 8px 14px;
            border-radius: 6px;
            cursor: pointer;
        }
        .btn.secondary { background: #6b7280; }
        .page { max-width: 900px; margin: 24px auto; padding: 24px; }
        .header {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 16px;
            border-bottom: 2px solid var(--border);
            padding-bottom: 16px;
            margin-bottom: 16px;
        }
        .company h2 { margin: 0 0 4px; font-size: 22px; }
        .muted { color: var(--muted); }
        .meta { text-align: right; }
        .meta h3 { margin: 0 0 6px; font-size: 20px; }
        .meta-line {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            font-size: 14px;
        }
        .section-title { font-size: 16px; margin: 18px 0 10px; }
        table { width: 100%; border-collapse: collapse; }
        th, td {
            border: 1px solid var(--border);
            padding: 8px 10px;
            font-size: 14px;
        }
        th { background: #f9fafb; text-align: left; }
        .text-right { text-align: right; }
        .totals {
            margin-top: 16px;
            width: 360px;
            margin-left: auto;
            border: 1px solid var(--border);
            border-radius: 6px;
            overflow: hidden;
        }
        .totals .row {
            display: grid;
            grid-template-columns: 1fr 140px;
            padding: 10px 12px;
            border-bottom: 1px solid var(--border);
        }
        .totals .row:last-child { border-bottom: 0; }
        .totals .grand {
            background: #f9fafb;
            font-weight: 700;
        }
        .notes {
            margin-top: 18px;
            padding: 12px;
            border: 1px dashed var(--border);
            background: #fcfcfd;
        }
        .footer {
            margin-top: 26px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            color: var(--muted);
            font-size: 13px;
        }
        .sign {
            border-top: 1px solid var(--border);
            padding-top: 10px;
            text-align: center;
        }
        .stamp {
            display: inline-block;
            padding: 6px 12px;
            border: 2px solid #10b981;
            color: #10b981;
            font-weight: 700;
            letter-spacing: 2px;
            transform: rotate(-4deg);
            font-size: 14px;
            margin-left: 8px;
        }
        @@media print {
            .toolbar { display: none; }
            .page { margin: 0; padding: 0; max-width: none; }
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <h1>Prepayment Receipt @p.PrepaymentNumber</h1>
        <div>
            <button class="btn" onclick="window.print()">Print / Save as PDF</button>
            <a href="@Url.Action("Details","Prepayment", new { id = p.Id })" class="btn secondary" style="text-decoration:none;">Back</a>
        </div>
    </div>

    <div class="page">
        <div class="header">
            <div class="company">
                <h2>@company.CompanyName</h2>
                <div class="muted">
                    @company.Address<br />
                    @company.City, @company.State<br />
                    Tel: @company.Phone | Email: @company.Email<br />
                    Website: @company.Website<br />
                    Tax No: @company.TaxNumber<br />
                    Bank: @company.BankDetails
                </div>
            </div>
            <div class="meta">
                <h3>PREPAYMENT RECEIPT <span class="stamp">PAID</span></h3>
                <div class="meta-line"><span>Receipt #</span><strong>@p.PrepaymentNumber</strong></div>
                <div class="meta-line"><span>Receipt Date</span><span>@p.PrepaymentDate.ToString("dd/MM/yyyy")</span></div>
                <div class="meta-line"><span>Expected Pickup</span><span>@(p.ExpectedPickupDate?.ToString("dd/MM/yyyy") ?? "-")</span></div>
                <div class="meta-line"><span>Payment Method</span><span>@(string.IsNullOrWhiteSpace(p.PaymentMethod) ? "-" : p.PaymentMethod)</span></div>
                <div class="meta-line"><span>Reference</span><span>@(string.IsNullOrWhiteSpace(p.Reference) ? "-" : p.Reference)</span></div>
            </div>
        </div>

        <h4 class="section-title">Received From</h4>
        <table>
            <tr>
                <td>
                    <strong>@(customer?.Name ?? "-")</strong><br />
                    @if (customer != null)
                    {
                        if (!string.IsNullOrWhiteSpace(customer.BillingAddress))
                        {
                            <span class="muted">@customer.BillingAddress<br /></span>
                        }
                        if (!string.IsNullOrWhiteSpace(customer.Phone))
                        {
                            <span class="muted">Phone: @customer.Phone<br /></span>
                        }
                        if (!string.IsNullOrWhiteSpace(customer.Email))
                        {
                            <span class="muted">Email: @customer.Email</span>
                        }
                    }
                </td>
            </tr>
        </table>

        <h4 class="section-title">Line Items</h4>
        <table>
            <thead>
                <tr>
                    <th>Material</th>
                    <th class="text-right">Qty</th>
                    <th>Unit</th>
                    <th class="text-right">Unit Price (₦)</th>
                    <th class="text-right">Line Total (₦)</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.LineItems != null && Model.LineItems.Any())
                {
                    foreach (var li in Model.LineItems)
                    {
                        <tr>
                            <td>@li.Material?.Name</td>
                            <td class="text-right">@li.Quantity.ToString("N3")</td>
                            <td>@li.Unit</td>
                            <td class="text-right">@li.UnitPrice.ToString("N2")</td>
                            <td class="text-right">@li.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="muted">No line items.</td></tr>
                }
            </tbody>
        </table>

        <div class="totals">
            <div class="row grand">
                <div>Total Amount Prepaid</div>
                <div class="text-right">₦@p.Amount.ToString("N2")</div>
            </div>
            <div class="row">
                <div>Applied to Date</div>
                <div class="text-right">₦@p.UsedAmount.ToString("N2")</div>
            </div>
            <div class="row">
                <div>Remaining Balance</div>
                <div class="text-right">₦@((p.Amount - p.UsedAmount).ToString("N2"))</div>
            </div>
        </div>

        <div class="notes">
            <strong>Amount in Words:</strong>
            <div>@Model.AmountInWords</div>
            @if (!string.IsNullOrWhiteSpace(p.Notes))
            {
                <div style="margin-top:8px;"><strong>Notes:</strong> @p.Notes</div>
            }
        </div>

        <div class="footer">
            <div class="sign">
                Authorized Signature
            </div>
            <div class="muted" style="text-align:right;">
                Generated on @Model.PrintDate.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
    </div>
</body>
</html>
